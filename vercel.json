{
  "redirects": [
    {
      "source": "/JacobDineen_CV.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/JacobDineen_CV_latest.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/JacobDineen_CV_Latest.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/pensieve/:path*",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/pensieve",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/papers/:file",
      "destination": "/publications/:file",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/cv/JacobDineen_CV.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.jacobdineen.com/cv/JacobDineen_CV.pdf>; rel=\"canonical\""
        }
      ]
    }
  ]
}
