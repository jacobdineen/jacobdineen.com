{
  "redirects": [
    {
      "source": "/JacobDineen_CV.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/JacobDineen_CV_latest.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/JacobDineen_CV_Latest.pdf",
      "destination": "/cv/JacobDineen_CV.pdf",
      "permanent": true
    },
    {
      "source": "/pensieve/:path*",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/pensieve",
      "destination": "/publications",
      "permanent": true
    },
    {
      "source": "/papers/:file",
      "destination": "/publications/:file",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:file((?!sw\\.js$)[^/]+\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(teasers|og|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/cv/JacobDineen_CV.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.jacobdineen.com/cv/JacobDineen_CV.pdf>; rel=\"canonical\""
        }
      ]
    }
  ]
}
